<div class="w-full space-y-8">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl text-gray-900">Configuración</h1>
  </div>

  <!-- Marketing & Integraciones -->
  <div class="bg-white shadow sm:rounded-lg overflow-hidden">
    <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b border-gray-200">
      <h3 class="text-lg leading-6 font-medium text-gray-900">
        Marketing & Pixel
      </h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">
        Configura los códigos de seguimiento para tus campañas.
      </p>
    </div>
    <div class="px-4 py-5 sm:p-6 space-y-6">
      <% @marketing_settings.each do |setting| %>
        <%= form_with(model: [:admin, setting], method: :patch, class: "grid grid-cols-1 gap-y-6 sm:grid-cols-6 sm:gap-x-4 items-end") do |f| %>
          <div class="sm:col-span-4">
            <label for="setting_value_<%= setting.id %>" class="block text-sm font-medium text-gray-700">
              <% case setting.key %>
              <% when 'facebook_pixel' %>
                Facebook Pixel ID
              <% when 'google_analytics_id' %>
                Google Analytics ID (G-XXXXX)
              <% else %>
                <%= setting.key.humanize %>
              <% end %>
            </label>
            <div class="mt-1 flex rounded-md shadow-sm">
              <% if setting.key == 'facebook_pixel' %>
                <span class="inline-flex items-center px-3 rounded-l-md border border-r-0 border-gray-300 bg-gray-50 text-gray-500 sm:text-sm">
                  ID:
                </span>
              <% end %>
              <%= f.text_field :value, id: "setting_value_#{setting.id}", class: "flex-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full min-w-0 rounded-none #{setting.key == 'facebook_pixel' ? 'rounded-r-md' : 'rounded-md'} sm:text-sm border-gray-300" %>
            </div>
            <% if setting.key == 'facebook_pixel' && setting.value.present? %>
              <p class="mt-2 text-sm text-green-600 flex items-center">
                <svg class="h-4 w-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                Pixel Activo
              </p>
            <% end %>
          </div>
          <div class="sm:col-span-2">
            <%= f.submit "Guardar", class: "w-full inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
          </div>
        <% end %>
      <% end %>
      
      <% if @marketing_settings.empty? %>
        <div class="text-sm text-gray-500 italic p-4 bg-yellow-50 rounded-md border border-yellow-200">
          ⚠️ No se encontraron configuraciones de marketing. Corre los seeds de la base de datos.
        </div>
      <% end %>
    </div>
  </div>

  <!-- Configuración General -->
  <div class="bg-white shadow sm:rounded-lg overflow-hidden">
    <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b border-gray-200">
      <h3 class="text-lg leading-6 font-medium text-gray-900">
        Configuración General
      </h3>
    </div>
    <ul role="list" class="divide-y divide-gray-200">
      <% @general_settings.each do |setting| %>
        <li class="px-4 py-4 sm:px-6">
          <%= form_with(model: [:admin, setting], method: :patch, class: "flex items-center gap-4") do |f| %>
            <div class="w-1/3">
              <label class="block text-sm font-medium text-gray-700"><%= setting.key.humanize %></label>
            </div>
            <div class="flex-1">
              <%= f.text_field :value, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md" %>
            </div>
            <div>
              <%= f.submit "Guardar", class: "inline-flex items-center px-3 py-2 border border-blue-600 text-sm leading-4 font-medium rounded-md text-blue-600 bg-white hover:bg-blue-50 focus:outline-none" %>
            </div>
          <% end %>
        </li>
      <% end %>
      <% if @general_settings.empty? %>
        <li class="px-4 py-4 text-sm text-gray-500 italic">No hay configuraciones generales.</li>
      <% end %>
    </ul>
  </div>
</div>
