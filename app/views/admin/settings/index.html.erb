<div class="w-full space-y-8">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl text-gray-900">Configuración</h1>
  </div>

  <!-- Marketing settings moved to Pixel Dashboard (/admin/pixel) -->

  <!-- Configuración General -->
  <div class="bg-white shadow sm:rounded-lg overflow-hidden">
    <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b border-gray-200">
      <h3 class="text-lg leading-6 font-medium text-gray-900">
        Configuración General
      </h3>
    </div>
    <ul role="list" class="divide-y divide-gray-200">
      <% @general_settings.each do |setting| %>
        <li class="px-4 py-4 sm:px-6">
          <%= form_with(model: [:admin, setting], method: :patch, class: "flex items-center gap-4") do |f| %>
            <div class="w-1/3">
              <label class="block text-sm font-medium text-gray-700"><%= setting.key.humanize %></label>
            </div>
            <div class="flex-1">
              <%= f.text_field :value, class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md p-2 text-gray-900 border" %>
            </div>
            <div>
              <%= f.submit "Guardar", class: "inline-flex items-center px-3 py-2 border border-blue-600 text-sm leading-4 font-medium rounded-md text-blue-600 bg-white hover:bg-blue-50 focus:outline-none" %>
            </div>
          <% end %>
        </li>
      <% end %>
      <% if @general_settings.empty? %>
        <li class="px-4 py-4 text-sm text-gray-500 italic">No hay configuraciones generales.</li>
      <% end %>
    </ul>
  </div>
</div>
