<% content_for :title, "Packages" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center mb-6">
    <h1 class="font-bold text-4xl">Paquetes</h1>
    <%= link_to "Nuevo Paquete", new_admin_package_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <div id="packages" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @packages.any? %>
      <% @packages.each do |package| %>
        <div class="bg-white rounded-lg shadow p-4 mb-4">
          <%= render package %>
          <div class="mt-4 flex gap-2 justify-end">
            <%= link_to "Ver", admin_package_path(package), class: "rounded-md px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium" %>
            <%= link_to "Editar", edit_admin_package_path(package), class: "rounded-md px-4 py-2 bg-gray-600 hover:bg-gray-700 text-white font-medium" %>
            <%= button_to "Eliminar", admin_package_path(package), method: :delete, class: "rounded-md px-4 py-2 text-white bg-red-600 hover:bg-red-700 font-medium", data: { turbo_confirm: "¿Estás seguro?" } %>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10 text-gray-500">No hay paquetes cargados aún.</p>
    <% end %>
  </div>
</div>
