<div class="space-y-2">
  <div class="flex justify-between items-start">
    <div class="flex-1">
      <h3 class="text-lg font-semibold text-gray-900"><%= package.title %></h3>
      <p class="text-sm text-gray-600 mt-1"><%= package.stars %></p>
    </div>
    <div class="text-right">
      <p class="text-xl font-bold text-indigo-600"><%= number_to_currency(package.price, precision: 0) %></p>
      <p class="text-sm text-gray-500"><%= package.duration %></p>
    </div>
  </div>

  <% if package.description.present? %>
    <p class="text-sm text-gray-700 line-clamp-2"><%= package.description %></p>
  <% end %>

  <div class="flex gap-2 text-xs text-gray-600">
    <span class="bg-gray-100 px-2 py-1 rounded"><%= package.regime %></span>
    <span class="bg-gray-100 px-2 py-1 rounded"><%= package.dates %></span>
    <%= form_with(model: [:admin, package], method: :patch, class: "inline-block") do |f| %>
      <%= f.hidden_field :featured, value: !package.featured %>
      <%= f.button type: "submit", class: "#{package.featured ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'} px-2 py-1 rounded hover:opacity-80 cursor-pointer" do %>
        <%= package.featured ? "✓ Destacado" : "☆ Destacar" %>
      <% end %>
    <% end %>
  </div>
</div>
